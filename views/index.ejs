<% layout('layout') -%>
<% title = 'Dashboard' %>

<!-- Panel de Estadísticas -->
<div class="row g-4 mb-4">
  <div class="col-md-3 col-6">
    <div class="dashboard-card">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <div class="label">Total Productos</div>
          <div class="number"><%= typeof productos !== 'undefined' ? productos.length : 0 %></div>
        </div>
        <div class="icon icon-blue">
          <i class="fas fa-box"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="dashboard-card">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <div class="label">Ingresos Totales</div>
          <div class="number"><%= typeof totalIngresos !== 'undefined' ? formatoMoneda(totalIngresos) : '$0.00' %></div>
        </div>
        <div class="icon icon-green">
          <i class="fas fa-dollar-sign"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="dashboard-card">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <div class="label">Ventas Realizadas</div>
          <div class="number"><%= typeof ventasRealizadas !== 'undefined' ? ventasRealizadas : 0 %></div>
        </div>
        <div class="icon icon-orange">
          <i class="fas fa-receipt"></i>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-3 col-6">
    <div class="dashboard-card">
      <div class="d-flex justify-content-between align-items-start">
        <div>
          <div class="label">Stock Bajo</div>
          <div class="number"><%= typeof alertasStock !== 'undefined' ? alertasStock.length : 0 %></div>
        </div>
        <div class="icon icon-red">
          <i class="fas fa-exclamation-triangle"></i>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Tarjeta de Tasa de Cambio -->
<div class="row mb-4">
  <div class="col-md-12">
    <div class="card-modern bg-info bg-opacity-10 border border-info">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <i class="fas fa-exchange-alt text-info me-2" style="font-size: 1.5rem;"></i>
          <span class="fw-bold">Tasa de Cambio Actual:</span>
        </div>
        <div>
          <span class="fs-4 fw-bold text-info">
            1 USD = Bs <%= typeof tasaActual !== 'undefined' && tasaActual ? tasaActual.valor : 'N/A' %>
          </span>
          <span class="text-muted ms-3">
            <i class="fas fa-calendar-alt me-1"></i>
            <%= typeof tasaActual !== 'undefined' && tasaActual ? formatoFechaMostrar(tasaActual.fecha) : 'No disponible' %>
          </span>
          <% if (usuario && usuario.rol === 'admin') { %>
            <a href="/tasa-cambio" class="btn btn-sm btn-modern-outline ms-3">
              <i class="fas fa-edit me-1"></i> Actualizar
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Ventas de Hoy, Alertas de Stock y Alertas de Vencimiento -->
<div class="row g-4">

  <!-- Ventas de Hoy -->
  <div class="col-lg-4">
    <div class="card-modern">
      <div class="card-header">
        <i class="fas fa-history me-2 text-primary"></i> Ventas de Hoy
        <span class="badge bg-primary rounded-pill ms-2"><%= typeof ventasHoy !== 'undefined' ? ventasHoy.length : 0 %></span>
      </div>
      <div class="card-body p-0">
        <% if (typeof ventasHoy !== 'undefined' && ventasHoy.length > 0) { %>
          <div class="list-group list-group-flush">
            <% ventasHoy.forEach(v => { %>
              <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                  <small class="text-muted"><%= formatoFechaMostrar(v.fecha) %></small>
                  <span class="badge bg-light text-dark ms-2"><%= v.tipo_pago %></span>
                </div>
                <span class="fw-bold"><%= formatoMoneda(v.total) %></span>
              </div>
            <% }) %>
          </div>
          <div class="p-3 bg-light border-top d-flex justify-content-between">
            <span class="fw-bold">Total del día:</span>
            <span class="fw-bold text-success"><%= typeof totalHoy !== 'undefined' ? formatoMoneda(totalHoy) : '$0.00' %></span>
          </div>
        <% } else { %>
          <div class="text-center py-4">
            <i class="fas fa-shopping-bag text-muted" style="font-size: 2rem;"></i>
            <p class="text-muted mt-2 mb-0">No hay ventas registradas hoy</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Alertas de Stock Mínimo -->
  <div class="col-lg-4">
    <div class="card-modern">
      <div class="card-header">
        <i class="fas fa-exclamation-circle me-2 text-warning"></i> Stock Bajo
        <span class="badge bg-danger rounded-pill ms-2"><%= typeof alertasStock !== 'undefined' ? alertasStock.length : 0 %></span>
      </div>
      <div class="card-body p-0">
        <% if (typeof alertasStock !== 'undefined' && alertasStock.length > 0) { %>
          <div class="list-group list-group-flush">
            <% alertasStock.forEach(a => { %>
              <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                  <i class="fas fa-box text-warning me-2"></i>
                  <%= a.nombre %>
                </div>
                <span class="badge bg-danger rounded-pill">
                  <i class="fas fa-arrow-down me-1"></i> <%= a.stock_total %>
                </span>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="text-center py-4">
            <i class="fas fa-check-circle text-success" style="font-size: 2rem;"></i>
            <p class="text-muted mt-2 mb-0">Stock suficiente en todos los productos</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Alertas de Vencimiento y Productos Vencidos -->
<div class="col-lg-4">
  <div class="card-modern">
    <div class="card-header d-flex justify-content-between align-items-center">
      <div>
        <i class="fas fa-calendar-times me-2 text-danger"></i> Vencimiento
      </div>
      <span class="badge bg-danger rounded-pill">
        <%= typeof alertasVencimiento !== 'undefined' ? alertasVencimiento.length : 0 %>
      </span>
    </div>
    <div class="card-body p-0">
      <% if (typeof alertasVencimiento !== 'undefined' && alertasVencimiento.length > 0) { %>
        <div class="list-group list-group-flush">
          <% alertasVencimiento.forEach(v => { %>
            <div class="list-group-item d-flex justify-content-between align-items-center">
              <div>
                <div class="fw-bold"><%= v.producto %></div>
                  <small class="text-muted">Lote #<%= v.id_lote %> (<%= v.cantidad_actual %> unid.)</small>
              </div>

              <% if (v.estado_vencimiento === 'vencido') { %>
                <span class="badge bg-danger text-white">
                  <i class="fas fa-times-circle me-1"></i> Vencido: <%= formatoFechaMostrar(v.fecha_vencimiento) %>
                </span>
              <% } else { %>
                <span class="badge bg-warning text-dark">
                  <i class="fas fa-exclamation-triangle me-1"></i> Vence: <%= formatoFechaMostrar(v.fecha_vencimiento) %>
                </span>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="text-center py-4">
          <i class="fas fa-calendar-check text-success" style="font-size: 2rem;"></i>
          <p class="text-muted mt-2 mb-0">Sin productos vencidos ni por vencer</p>
        </div>
      <% } %>
    </div>
  </div>
</div>