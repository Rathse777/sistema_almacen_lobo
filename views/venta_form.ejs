<% layout('layout') -%>
<% title = venta ? 'Editar venta' : 'Nueva venta' %>

<div class="row">
  <div class="col-lg-10 mx-auto">
    <div class="card-modern">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-shopping-cart me-2"></i><%= title %></span>
        <div class="d-flex gap-3 align-items-center">
          <span class="fs-6 text-muted" id="header-total-bs">Total Bs: Bs 0.00</span>
          <span class="fs-5 fw-bold text-primary" id="header-total">Total: $0.00</span>
        </div>
      </div>
      <div class="card-body">
        <% if (error) { %>
          <div class="alert alert-modern alert-modern-danger">
            <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
          </div>
        <% } %>

        <!-- Buscador de productos -->
        <div class="mb-4 position-relative">
          <label class="form-label fw-semibold">
            <i class="fas fa-search me-2 text-muted"></i>Buscar Producto por Nombre o Código
          </label>
          <input type="text" id="input-buscador" class="form-control form-control-lg" placeholder="Escriba para buscar..." autocomplete="off">
          <div id="resultados-busqueda" class="list-group position-absolute w-100 shadow-sm z-3 d-none mt-1" style="max-height: 250px; overflow-y: auto;"></div>
        </div>

        <div class="alert alert-info d-flex align-items-center" role="alert">
          <i class="fas fa-info-circle me-2"></i>
          <div>
            <span>Tasa de cambio actual: <strong>1 USD = Bs <%= typeof tasaActual !== 'undefined' ? tasaActual.valor : 'N/A' %></strong></span>
          </div>
        </div>

        <!-- Formulario principal con Carrito -->
        <form id="formVenta" method="POST" action="<%= venta ? ('/ventas/' + venta.id_venta + '/editar') : '/ventas' %>">
          
          <input type="hidden" name="monto_recibido" id="monto_recibido_hidden" value="">

          <div class="table-responsive mb-3">
            <table class="table table-hover align-middle">
              <thead class="table-light">
                <tr>
                  <th>Producto</th>
                  <th style="width: 130px;">Precio Unit. ($)</th>
                  <th style="width: 130px;">Precio Unit. (Bs)</th>
                  <th style="width: 140px;">Cantidad</th>
                  <th style="width: 130px;" class="text-end">Subtotal</th>
                  <th style="width: 130px;" class="text-end">Subtotal (Bs)</th>
                  <th style="width: 60px;"></th>
                </tr>
              </thead>
              <tbody id="carrito-body">
                <!-- Se llena dinámicamente -->
              </tbody>
            </table>
          </div>

          <div id="carrito-vacio-msg" class="text-center py-4 text-muted">
            <i class="fas fa-cart-arrow-down fa-2x mb-2"></i>
            <p class="mb-0">El carrito está vacío. Use la barra superior para agregar productos.</p>
          </div>

          <hr>

          <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-light rounded">
            <div>
              <span class="fs-5 fw-bold">Monto Total:</span>
              <span class="fs-3 fw-bold text-primary" id="monto-total-display">$0.00</span>
            </div>
            <div>
              <span class="fs-5 fw-bold">Total en Bs:</span>
              <span class="fs-3 fw-bold text-success" id="monto-total-bs-display">Bs 0.00</span>
            </div>
          </div>

          <div class="d-flex gap-2">
            <button class="btn btn-modern-primary px-4" type="button" onclick="prepararModalCobro()">
              <i class="fas fa-calculator me-2"></i> Procesar y Calcular Vuelto
            </button>
            <a class="btn btn-modern-outline" href="/ventas">
              <i class="fas fa-times me-1"></i> Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Modal para Vuelto / Confirmación -->
<div class="modal fade" id="modalVuelto" tabindex="-1" aria-labelledby="modalVueltoLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold" id="modalVueltoLabel">
          <i class="fas fa-cash-register me-2"></i>Calcular Vuelto (Bolívares)
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label fw-semibold">Total a Pagar</label>
          <div class="d-flex justify-content-between">
            <span class="fs-5 text-muted" id="modal-total-pagar">$0.00</span>
            <span class="fs-4 fw-bold text-success" id="modal-total-pagar-bs">Bs 0.00</span>
          </div>
        </div>
        <div class="mb-3">
          <label for="modal-monto-recibido" class="form-label fw-semibold">Monto Recibido (Bs)</label>
          <div class="input-group">
            <span class="input-group-text">Bs</span>
            <input type="text" step="0.01" min="0" class="form-control form-control-lg" 
                  id="modal-monto-recibido" placeholder="0.00" 
                  oninput="calcularVuelto()" 
                  onkeypress="return (event.charCode >= 48 && event.charCode <= 57) || event.charCode === 44 || event.charCode === 46">
          </div>
          <small class="text-muted">Use punto o coma para decimales</small>
        </div>
        <div class="p-3 bg-light rounded text-center">
          <span class="d-block text-muted mb-1">Vuelto a Entregar (Bolívares):</span>
          <span class="fs-2 fw-bold text-success" id="modal-vuelto-display">Bs 0.00</span>
        </div>
        <div id="modal-error-monto" class="alert alert-danger mt-3 d-none">
          <i class="fas fa-exclamation-circle me-2"></i>
          El monto recibido es menor al total a pagar.
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-modern-outline" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-modern-primary" id="btn-confirmar-venta" onclick="confirmarVenta()">
          <i class="fas fa-check me-1"></i> Confirmar y Guardar
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  // Cargar catálogo desde servidor
  const catalogoProductos = JSON.parse('<%- JSON.stringify(productos || []) %>');
  const detallesExistentes = JSON.parse('<%- JSON.stringify(detalles || []) %>');
  
  // Obtener la tasa actual de forma segura
  const TasaActual = JSON.parse('<%- typeof TasaActual !== "undefined" ? TasaActual.valor : 0 %>');
  
  let carrito = [];
  let totalGeneral = 0;
  let totalGeneralBs = 0;

  document.addEventListener('DOMContentLoaded', () => {
    if (detallesExistentes && detallesExistentes.length > 0) {
      detallesExistentes.forEach(d => {
        const prod = catalogoProductos.find(p => p.id_producto === d.id_producto) || {
          id_producto: d.id_producto,
          nombre: d.producto_nombre || 'Producto',
          precio_venta: d.precio_unitario,
          precio_venta_bs: d.precio_unitario_bs || 0,
          stock_total: 999
        };
        carrito.push({
          id_producto: prod.id_producto,
          nombre: prod.nombre,
          precio: d.precio_unitario || prod.precio_venta,
          precioBs: d.precio_unitario_bs || prod.precio_venta_bs || 0,
          cantidad: d.cantidad,
          stock: prod.stock_total
        });
      });
      renderizarCarrito();
    }

    const inputBuscador = document.getElementById('input-buscador');
    const resultadosDiv = document.getElementById('resultados-busqueda');

    inputBuscador.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      if (!q) {
        resultadosDiv.classList.add('d-none');
        return;
      }

      const coincidentes = catalogoProductos.filter(p => 
        p.nombre.toLowerCase().includes(q) || (p.codigo && p.codigo.toLowerCase().includes(q))
      );

      if (coincidentes.length === 0) {
        resultadosDiv.innerHTML = '<div class="list-group-item text-muted">No se encontraron productos</div>';
      } else {
        resultadosDiv.innerHTML = coincidentes.map(p => `
          <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" onclick="agregarAlCarrito(${p.id_producto})">
            <div>
              <strong>${p.nombre}</strong>
              <small class="text-muted d-block">${p.codigo ? 'Cód: ' + p.codigo + ' | ' : ''}Stock: ${p.stock_total}</small>
            </div>
            <div class="text-end">
              <span class="badge bg-primary fs-6">$${parseFloat(p.precio_venta || 0).toFixed(2)}</span>
              <br>
              <span class="badge bg-success fs-6">Bs ${parseFloat(p.precio_venta_bs || 0).toFixed(2)}</span>
            </div>
          </button>
        `).join('');
      }

      resultadosDiv.classList.remove('d-none');
    });

    document.addEventListener('click', (e) => {
      if (!inputBuscador.contains(e.target) && !resultadosDiv.contains(e.target)) {
        resultadosDiv.classList.add('d-none');
      }
    });
  });

  function agregarAlCarrito(idProducto) {
    const prod = catalogoProductos.find(p => p.id_producto === idProducto);
    if (!prod) return;

    const itemExistente = carrito.find(item => item.id_producto === idProducto);
    if (itemExistente) {
      if (itemExistente.cantidad < prod.stock_total) {
        itemExistente.cantidad++;
      } else {
        alert('Ha alcanzado el límite de stock disponible para este producto.');
      }
    } else {
      carrito.push({
        id_producto: prod.id_producto,
        nombre: prod.nombre,
        precio: parseFloat(prod.precio_venta || 0),
        precioBs: parseFloat(prod.precio_venta_bs || 0),
        cantidad: 1,
        stock: prod.stock_total
      });
    }

    document.getElementById('input-buscador').value = '';
    document.getElementById('resultados-busqueda').classList.add('d-none');
    renderizarCarrito();
  }

  function cambiarCantidad(idProducto, nuevaCantidad) {
    const cant = parseInt(nuevaCantidad, 10);
    const item = carrito.find(i => i.id_producto === idProducto);
    if (!item) return;

    if (cant <= 0 || isNaN(cant)) {
      eliminarDelCarrito(idProducto);
    } else {
      item.cantidad = cant;
      renderizarCarrito();
    }
  }

  function eliminarDelCarrito(idProducto) {
    carrito = carrito.filter(item => item.id_producto !== idProducto);
    renderizarCarrito();
  }

  function renderizarCarrito() {
    const tbody = document.getElementById('carrito-body');
    const msgVacio = document.getElementById('carrito-vacio-msg');
    tbody.innerHTML = '';
    totalGeneral = 0;
    totalGeneralBs = 0;

    if (carrito.length === 0) {
      msgVacio.classList.remove('d-none');
    } else {
      msgVacio.classList.add('d-none');
    }

    carrito.forEach(item => {
      const subtotal = item.precio * item.cantidad;
      const subtotalBs = item.precioBs * item.cantidad;
      totalGeneral += subtotal;
      totalGeneralBs += subtotalBs;

      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td>
          <input type="hidden" name="producto_id" value="${item.id_producto}">
          <strong>${item.nombre}</strong>
        </td>
        <td>$${item.precio.toFixed(2)}</td>
        <td>Bs ${item.precioBs.toFixed(2)}</td>
        <td>
          <input type="number" name="cantidad" min="1" max="${item.stock}" class="form-control form-control-sm" value="${item.cantidad}" onchange="cambiarCantidad(${item.id_producto}, this.value)">
        </td>
        <td class="text-end fw-bold">$${subtotal.toFixed(2)}</td>
        <td class="text-end fw-bold text-success">Bs ${subtotalBs.toFixed(2)}</td>
        <td class="text-center">
          <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarDelCarrito(${item.id_producto})">
            <i class="fas fa-trash"></i>
          </button>
        </td>
      `;
      tbody.appendChild(tr);
    });

    document.getElementById('monto-total-display').textContent = `$${totalGeneral.toFixed(2)}`;
    document.getElementById('monto-total-bs-display').textContent = `Bs ${totalGeneralBs.toFixed(2)}`;
    document.getElementById('header-total').textContent = `Total: $${totalGeneral.toFixed(2)}`;
    document.getElementById('header-total-bs').textContent = `Total Bs: Bs ${totalGeneralBs.toFixed(2)}`;
  }

  function prepararModalCobro() {
    if (carrito.length === 0) {
      alert('Debe agregar al menos un producto al carrito.');
      return;
    }

    document.getElementById('modal-total-pagar').textContent = `$${totalGeneral.toFixed(2)}`;
    document.getElementById('modal-total-pagar-bs').textContent = `Bs ${totalGeneralBs.toFixed(2)}`;
    document.getElementById('modal-monto-recibido').value = '';
    document.getElementById('modal-vuelto-display').textContent = 'Bs 0.00';
    document.getElementById('modal-error-monto').classList.add('d-none');
    document.getElementById('btn-confirmar-venta').disabled = false;

    const modal = new bootstrap.Modal(document.getElementById('modalVuelto'));
    modal.show();
  }
function calcularVuelto() {
  const recibidoInput = document.getElementById('modal-monto-recibido').value;
  // 🔥 CORREGIDO: Manejar comas y puntos correctamente
  const recibidoStr = recibidoInput.replace(',', '.').trim();
  const recibido = parseFloat(recibidoStr) || 0;
  const vueltoSpan = document.getElementById('modal-vuelto-display');
  const errorDiv = document.getElementById('modal-error-monto');
  const btnConfirmar = document.getElementById('btn-confirmar-venta');

  if (recibidoInput === '') {
    vueltoSpan.textContent = 'Bs 0.00';
    errorDiv.classList.add('d-none');
    btnConfirmar.disabled = false;
    return;
  }

  if (isNaN(recibido) || recibido < 0) {
    vueltoSpan.textContent = 'Bs 0.00';
    errorDiv.classList.remove('d-none');
    errorDiv.textContent = 'Ingrese un monto válido.';
    btnConfirmar.disabled = true;
    return;
  }

  const vuelto = recibido - totalGeneralBs;

  if (vuelto < 0) {
    vueltoSpan.textContent = 'Bs 0.00';
    errorDiv.classList.remove('d-none');
    errorDiv.textContent = 'El monto recibido es menor al total a pagar.';
    btnConfirmar.disabled = true;
  } else {
    vueltoSpan.textContent = `Bs ${vuelto.toFixed(2)}`;
    errorDiv.classList.add('d-none');
    btnConfirmar.disabled = false;
  }
}

function confirmarVenta() {
  const recibidoInput = document.getElementById('modal-monto-recibido').value;
  // 🔥 CORREGIDO: Asegurar que el valor se envia correctamente
  const recibidoStr = recibidoInput.replace(',', '.').trim();
  const recibidoNum = parseFloat(recibidoStr) || 0;
  
  if (recibidoNum < totalGeneralBs) {
    alert('El monto recibido es menor al total a pagar.');
    return;
  }
  
  document.getElementById('monto_recibido_hidden').value = recibidoNum;
  document.getElementById('formVenta').submit();
}

</script>