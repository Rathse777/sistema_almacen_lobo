<% layout('layout') -%>
<% title = lote ? 'Editar Lote' : 'Nuevo Lote' %>

<div class="card-modern p-4 col-md-8 mx-auto">
  <h4 class="fw-bold mb-3"><%= lote ? 'Editar Lote' : 'Registrar Nuevo Lote' %></h4>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <!-- IMPORTANTE: El action debe apuntar a /lotes/nuevo para creación -->
  <form action="<%= lote ? '/lotes/' + lote.id_lote + '/editar' : '/lotes/nuevo' %>" method="POST">
    
    <!-- Selección de Producto (name="id_producto") -->
    <div class="mb-3">
      <label for="id_producto" class="form-label fw-semibold">Producto</label>
      <select name="id_producto" id="id_producto" class="form-select" required>
        <option value="">-- Seleccione un Producto --</option>
        <% productos.forEach(p => { %>
          <option value="<%= p.id_producto %>" <%= (lote && lote.id_producto === p.id_producto) ? 'selected' : '' %>>
            <%= p.nombre %> <%= p.codigo ? '(' + p.codigo + ')' : '' %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="row g-3 mb-3">
      <!-- Cantidad (name="cantidad") -->
      <div class="col-md-6">
        <label for="cantidad" class="form-label fw-semibold">Cantidad del Lote</label>
        <input type="number" name="cantidad" id="cantidad" class="form-content form-control" min="1" value="<%= lote ? lote.cantidad_actual : '' %>" required>
      </div>

      <!-- Fecha de Vencimiento (name="fecha_vencimiento") -->
      <div class="col-md-6">
        <label for="fecha_vencimiento" class="form-label fw-semibold">Fecha de Vencimiento</label>
        <input type="date" name="fecha_vencimiento" id="fecha_vencimiento" class="form-control" value="<%= lote ? lote.fecha_vencimiento : '' %>">
      </div>
    </div>

    <div class="row g-3 mb-4">
      <!-- Precio Compra (name="precio_compra") -->
      <div class="col-md-6">
        <label for="precio_compra" class="form-label fw-semibold">Precio de Compra (Costo)</label>
        <input type="number" step="0.01" name="precio_compra" id="precio_compra" class="form-control" value="<%= lote ? lote.precio_compra : '0.00' %>">
      </div>

      <!-- Precio Venta (name="precio_venta") -->
      <div class="col-md-6">
        <label for="precio_venta" class="form-label fw-semibold">Precio de Venta del Lote</label>
        <input type="number" step="0.01" name="precio_venta" id="precio_venta" class="form-control" value="<%= lote ? lote.precio_venta : '0.00' %>">
      </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
      <a href="/lotes" class="btn btn-secondary">Cancelar</a>
      <button type="submit" class="btn btn-primary"><%= lote ? 'Actualizar' : 'Guardar Lote' %></button>
    </div>
  </form>
</div>