<% layout('layout') -%>
<% title = lote ? 'Editar lote' : 'Nuevo lote' %>

<div class="row">
  <div class="col-lg-8 mx-auto">
    <div class="card-modern">
      <div class="card-header">
        <i class="fas fa-archive me-2"></i>
        <%= title %>
      </div>
      <div class="card-body">
        <% if (error) { %>
          <div class="alert alert-modern alert-modern-danger">
            <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
          </div>
        <% } %>

        <form method="POST" action="<%= lote ? ('/lotes/' + lote.id_lote + '/editar') : '/lotes' %>">
          <div class="mb-3">
            <label class="form-label fw-semibold">
              <i class="fas fa-box me-2 text-muted"></i>Producto Asignado
            </label>
            <select name="id_producto" class="form-select" required>
              <% productos.forEach(p => { %>
                <option value="<%= p.id_producto %>" <%= lote && lote.id_producto === p.id_producto ? 'selected' : '' %>>
                  <%= p.nombre %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">Cantidad Comprada</label>
              <input name="cantidad_inicial" type="number" min="1" class="form-control" 
                     value="<%= lote ? lote.cantidad_inicial : 0 %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Cantidad Actual</label>
              <input name="cantidad_actual" type="number" min="0" class="form-control" 
                     value="<%= lote ? lote.cantidad_actual : 0 %>">
            </div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-md-6">
              <label class="form-label fw-semibold">
                <i class="fas fa-dollar-sign me-1 text-muted"></i>Precio Compra ($)
              </label>
              <input name="precio_compra" type="number" step="0.01" min="0" class="form-control" 
                     value="<%= lote ? lote.precio_compra : 0 %>">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">
                <i class="fas fa-tag me-1 text-muted"></i>Precio Venta ($)
              </label>
              <input name="precio_venta" type="number" step="0.01" min="0" class="form-control" 
                     value="<%= lote ? lote.precio_venta : 0 %>">
            </div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-md-6">
              <label class="form-label fw-semibold">
                <i class="fas fa-calendar-plus me-1 text-muted"></i>Fecha Ingreso
              </label>
              <input name="fecha_ingreso" class="form-control" 
                     value="<%= lote ? formatoFechaMostrar(lote.fecha_ingreso) : '' %>" 
                     placeholder="dd/mm/aaaa">
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">
                <i class="fas fa-calendar-times me-1 text-muted"></i>Fecha Vencimiento
              </label>
              <input name="fecha_vencimiento" class="form-control" 
                     value="<%= lote ? formatoFechaMostrar(lote.fecha_vencimiento) : '' %>" 
                     placeholder="dd/mm/aaaa">
            </div>
          </div>

          <hr>

          <div class="d-flex gap-2">
            <button class="btn btn-modern-primary px-4" type="submit">
              <i class="fas fa-save me-2"></i> Guardar Lote
            </button>
            <a class="btn btn-modern-outline" href="/lotes">
              <i class="fas fa-times me-1"></i> Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>