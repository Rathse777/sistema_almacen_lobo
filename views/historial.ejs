<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Historial de Movimientos</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">
  <!-- Encabezado -->
  <header class="bg-slate-800 text-white p-4 shadow-md">
    <div class="container mx-auto flex justify-between items-center">
      <h1 class="text-xl font-bold">Historial de Movimientos</h1>
      <a href="/" class="text-sm bg-slate-700 hover:bg-slate-600 px-3 py-2 rounded text-white transition">Volver al Inicio</a>
    </div>
  </header>

  <!-- Contenido -->
  <main class="container mx-auto flex-1 p-6">
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <div class="p-4 border-b border-gray-200">
        <h2 class="text-lg font-bold text-gray-700">Registro de Actividades</h2>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-sm text-gray-600">
          <thead class="bg-gray-50 text-gray-700 uppercase text-xs border-b">
            <tr>
              <th class="p-4">Fecha / Hora</th>
              <th class="p-4">Tipo de Acción</th>
              <th class="p-4">Descripción</th>
              <th class="p-4">Usuario</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% if (typeof historial !== 'undefined' && historial.length > 0) { %>
              <% historial.forEach(item => { %>
                <tr class="hover:bg-gray-50">
                  <td class="p-4 whitespace-nowrap"><%= item.fecha %></td>
                  <td class="p-4"><span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full"><%= item.tipo %></span></td>
                  <td class="p-4"><%= item.descripcion %></td>
                  <td class="p-4"><%= item.usuario || 'Sistema' %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="4" class="p-6 text-center text-gray-400">No hay movimientos registrados en el historial.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</body>
</html>