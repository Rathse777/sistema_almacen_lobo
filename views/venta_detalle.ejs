<% layout('layout') -%>
<% title = 'Detalle de Venta #' + venta.id_venta %>

<div class="row">
  <div class="col-lg-10 mx-auto">
    <div class="card-modern">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span>
          <i class="fas fa-receipt me-2"></i>
          Detalle de Venta #<%= venta.id_venta %>
        </span>
        <span class="badge <%= venta.anulada ? 'bg-danger' : 'bg-success' %>">
          <%= venta.anulada ? 'Anulada' : 'Activa' %>
        </span>
      </div>
      <div class="card-body">
        <div class="row mb-4">
          <div class="col-md-6">
            <p><strong>Fecha:</strong> <%= formatoFechaMostrar(venta.fecha) %></p>
            <p><strong>Atendido por:</strong> <%= venta.usuario_nombre || 'Sistema' %></p>
            <p><strong>Tasa de Cambio:</strong> 1 USD = Bs <%= venta.tasa_cambio || 'N/A' %></p>
          </div>
          <div class="col-md-6 text-md-end">
            <p>
              <strong>Total en Dólares:</strong> 
              <span class="text-primary fs-5"><%= formatoMoneda(venta.total) %></span>
            </p>
            <p>
              <strong>Total en Bolívares:</strong> 
              <span class="text-success fs-5"><%= formatoBolivares(venta.total_bs) %></span>
            </p>
            <p>
              <strong>Monto Recibido (Bs):</strong> 
              <span class="fw-bold text-primary">
                <%= venta.monto_recibido ? formatoBolivares(venta.monto_recibido) : '-' %>
              </span>
            </p>
            <p>
              <strong>Vuelto (Bs):</strong> 
              <span class="fw-bold text-success">
                <% if (venta.monto_recibido && venta.total_bs) { %>
                  <%= formatoBolivares(venta.monto_recibido - venta.total_bs) %>
                <% } else { %>
                  -
                <% } %>
              </span>
            </p>
          </div>
        </div>

        <hr>

        <h5 class="fw-bold mb-3"><i class="fas fa-list me-2"></i>Productos Vendidos</h5>
        <div class="table-responsive">
          <table class="table table-hover">
            <thead class="table-light">
              <tr>
                <th>Producto</th>
                <th>Código</th>
                <th class="text-center">Cantidad</th>
                <th class="text-end">Precio Unit. ($)</th>
                <th class="text-end">Precio Unit. (Bs)</th>
                <th class="text-end">Subtotal ($)</th>
                <th class="text-end">Subtotal (Bs)</th>
              </tr>
            </thead>
            <tbody>
              <% detalles.forEach(d => { %>
                <tr>
                  <td><strong><%= d.producto_nombre %></strong></td>
                  <td><%= d.codigo || '-' %></td>
                  <td class="text-center"><span class="badge bg-secondary"><%= d.cantidad %></span></td>
                  <td class="text-end"><%= formatoMoneda(d.precio_unitario) %></td>
                  <td class="text-end"><%= formatoBolivares(d.precio_unitario_bs) %></td>
                  <td class="text-end"><%= formatoMoneda(d.precio_unitario * d.cantidad) %></td>
                  <td class="text-end text-success fw-semibold"><%= formatoBolivares(d.precio_unitario_bs * d.cantidad) %></td>
                </tr>
              <% }) %>
            </tbody>
            <tfoot>
              <tr class="table-light fw-bold">
                <td colspan="6" class="text-end">Total General:</td>
                <td class="text-end text-success"><%= formatoBolivares(venta.total_bs) %></td>
              </tr>
            </tfoot>
          </table>
        </div>

        <hr>

        <div class="d-flex justify-content-end gap-3">
          <a class="btn btn-modern-outline" href="/ventas">
            <i class="fas fa-arrow-left me-1"></i> Volver
          </a>
          <% if (!venta.anulada && usuario && usuario.rol === 'admin') { %>
            <form style="display:inline" method="POST" action="/ventas/<%= venta.id_venta %>/anular" 
                  onsubmit="return confirm('¿Anular esta venta? Se restaurará el stock.')">
              <button class="btn btn-modern-danger">
                <i class="fas fa-ban me-1"></i> Anular Venta
              </button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>