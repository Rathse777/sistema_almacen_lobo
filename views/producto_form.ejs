<% layout('layout') -%>
<% title = producto ? 'Editar producto' : 'Nuevo producto' %>

<h2><%= title %></h2>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

<form method="POST" action="<%= producto ? ('/productos/' + producto.id_producto + '/editar') : '/productos' %>">
  <div class="mb-3">
    <label class="form-label">Nombre</label>
    <input name="nombre" class="form-control" value="<%= producto ? producto.nombre : '' %>" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Código</label>
    <input name="codigo" class="form-control" value="<%= producto ? producto.codigo : '' %>">
  </div>
  <div class="mb-3">
    <label class="form-label">Descripción</label>
    <textarea name="descripcion" class="form-control"><%= producto ? producto.descripcion : '' %></textarea>
  </div>
  <div class="mb-3">
    <label class="form-label">Categoría</label>
    <select name="id_categoria" class="form-select">
      <option value="">-- Sin categoría --</option>
      <% categorias.forEach(c => { %>
        <option value="<%= c.id_categoria %>" <%= producto && producto.id_categoria === c.id_categoria ? 'selected' : '' %>><%= c.nombre %></option>
      <% }) %>
    </select>
  </div>
  <div class="row">
    <div class="col-md-3 mb-3">
      <label class="form-label">Stock total</label>
      <input name="stock_total" type="number" min="0" class="form-control" value="<%= producto ? producto.stock_total : 0 %>">
    </div>
    <div class="col-md-3 mb-3">
      <label class="form-label">Stock mínimo</label>
      <input name="stock_minimo" type="number" min="0" class="form-control" value="<%= producto ? producto.stock_minimo : 0 %>">
    </div>
    <div class="col-md-3 mb-3">
      <label class="form-label">Precio venta ($)</label>
      <input name="precio_venta" type="number" step="0.01" min="0" class="form-control" value="<%= producto ? producto.precio_venta : 0 %>">
    </div>
    <div class="col-md-3 mb-3">
      <label class="form-label">Fecha vencimiento (dd/mm/yyyy)</label>
      <input name="fecha_vencimiento" class="form-control" value="<%= producto && producto.fecha_vencimiento ? formatoFechaMostrar(producto.fecha_vencimiento) : '' %>">
    </div>
  </div>
  <button class="btn btn-primary">Guardar</button>
  <a class="btn btn-secondary" href="/productos">Cancelar</a>
</form>