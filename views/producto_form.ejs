<% layout('layout') -%>
<% title = producto ? 'Editar producto' : 'Nuevo producto' %>

<div class="row">
  <div class="col-lg-8 mx-auto">
    <div class="card-modern">
      <div class="card-header">
        <i class="fas fa-box me-2"></i>
        <%= title %>
      </div>
      <div class="card-body">
        <% if (error) { %>
          <div class="alert alert-modern alert-modern-danger">
            <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
          </div>
        <% } %>

        <form method="POST" action="<%= producto ? ('/productos/' + producto.id_producto + '/editar') : '/productos' %>">
          <div class="mb-3">
            <label class="form-label fw-semibold">
              <i class="fas fa-tag me-2 text-muted"></i>Nombre del Producto
            </label>
            <input name="nombre" class="form-control" value="<%= producto ? producto.nombre : '' %>" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">
              <i class="fas fa-barcode me-2 text-muted"></i>Código (opcional)
            </label>
            <input name="codigo" class="form-control" value="<%= producto ? producto.codigo : '' %>" placeholder="Código único para el producto">
            <small class="text-muted">Si se deja vacío, no se asignará código.</small>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">
              <i class="fas fa-align-left me-2 text-muted"></i>Descripción
            </label>
            <textarea name="descripcion" class="form-control" rows="2"><%= producto ? producto.descripcion : '' %></textarea>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">
              <i class="fas fa-folder me-2 text-muted"></i>Categoría
            </label>
            <select name="id_categoria" class="form-select">
              <option value="">-- Sin categoría --</option>
              <% categorias.forEach(c => { %>
                <option value="<%= c.id_categoria %>" <%= producto && producto.id_categoria === c.id_categoria ? 'selected' : '' %>><%= c.nombre %></option>
              <% }) %>
            </select>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">
                <i class="fas fa-boxes me-2 text-muted"></i>Stock Total
              </label>
              <input name="stock_total" type="number" min="0" class="form-control" value="<%= producto ? producto.stock_total : 0 %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">
                <i class="fas fa-exclamation-triangle me-2 text-muted"></i>Stock Mínimo
              </label>
              <input name="stock_minimo" type="number" min="0" class="form-control" value="<%= producto ? producto.stock_minimo : 0 %>">
            </div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-md-6">
              <label class="form-label fw-semibold">
                <i class="fas fa-dollar-sign me-2 text-muted"></i>Precio de Compra ($)
              </label>
              <input name="precio_compra" type="number" step="0.01" min="0" class="form-control" value="<%= producto ? producto.precio_compra || 0 : 0 %>">
              <small class="text-muted">Costo de adquisición del producto</small>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">
                <i class="fas fa-tag me-2 text-muted"></i>Precio de Venta ($)
              </label>
              <input name="precio_venta" type="number" step="0.01" min="0" class="form-control" value="<%= producto ? producto.precio_venta : 0 %>" required>
            </div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-md-6">
              <label class="form-label fw-semibold">
                <i class="fas fa-calendar-times me-2 text-muted"></i>Fecha Vencimiento
              </label>
              <input name="fecha_vencimiento" class="form-control" value="<%= producto && producto.fecha_vencimiento ? formatoFechaMostrar(producto.fecha_vencimiento) : '' %>" placeholder="dd/mm/aaaa">
            </div>
            <div class="col-md-6">
              <!-- Espacio para mostrar tasa actual -->
              <label class="form-label fw-semibold">Tasa de Cambio</label>
              <div class="alert alert-info mb-0">
                <i class="fas fa-exchange-alt me-2"></i>
                1 USD = Bs <strong><%= typeof tasaActual !== 'undefined' ? tasaActual.valor : 'N/A' %></strong>
              </div>
            </div>
          </div>

          <hr>

          <% if (producto) { %>
            <div class="alert alert-warning">
              <i class="fas fa-info-circle me-2"></i>
              <strong>Nota:</strong> Al editar un producto, el lote asociado se actualizará automáticamente.
            </div>
          <% } else { %>
            <div class="alert alert-info">
              <i class="fas fa-info-circle me-2"></i>
              <strong>Nota:</strong> Al crear un nuevo producto, se creará automáticamente un lote inicial con los datos ingresados.
            </div>
          <% } %>

          <div class="d-flex gap-2">
            <button class="btn btn-modern-primary px-4" type="submit">
              <i class="fas fa-save me-2"></i> <%= producto ? 'Actualizar Producto' : 'Crear Producto' %>
            </button>
            <a class="btn btn-modern-outline" href="/productos">
              <i class="fas fa-times me-1"></i> Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>