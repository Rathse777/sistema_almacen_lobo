<% layout('layout') -%>
<% title = 'Iniciar sesión' %>

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
  <div class="col-md-5 col-lg-4">
    <div class="card-modern p-4">
      <div class="text-center mb-4">
        <div style="background: linear-gradient(135deg, #e94560, #c23152); width: 72px; height: 72px; border-radius: 20px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
          <i class="fas fa-store" style="color: white; font-size: 32px;"></i>
        </div>
        <h3 class="fw-bold" style="letter-spacing: -0.5px;">Bienvenido</h3>
        <p class="text-muted" style="font-size: 0.9rem;">Inicia sesión en tu cuenta</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-modern alert-modern-danger d-flex align-items-center">
          <i class="fas fa-exclamation-circle me-2"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/login">
        <div class="mb-3">
          <label class="form-label fw-semibold"><i class="fas fa-user me-2 text-muted"></i>Usuario</label>
          <div class="input-group">
            <span class="input-group-text bg-light border-0" style="border-radius: 10px 0 0 10px;">
              <i class="fas fa-user text-muted"></i>
            </span>
            <input name="nombre" class="form-control" placeholder="admin o cajero" required style="border-radius: 0 10px 10px 0;">
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label fw-semibold"><i class="fas fa-lock me-2 text-muted"></i>Contraseña</label>
          <div class="input-group">
            <span class="input-group-text bg-light border-0" style="border-radius: 10px 0 0 10px;">
              <i class="fas fa-lock text-muted"></i>
            </span>
            <input name="contraseña" type="password" class="form-control" placeholder="••••••••" required style="border-radius: 0 10px 10px 0;">
          </div>
        </div>

        <button class="btn btn-modern-primary w-100 py-2 fw-semibold" style="border-radius: 10px; font-size: 1rem;">
          <i class="fas fa-sign-in-alt me-2"></i> Iniciar Sesión
        </button>
      </form>

      <hr class="my-4">

      <div class="text-center">
        <small class="text-muted">
          <i class="fas fa-info-circle me-1"></i>
          Admin: <strong>admin</strong> / <strong>adminpass</strong>
          <span class="mx-2">•</span>
          Cajero: <strong>cajero</strong> / <strong>cajeropass</strong>
        </small>
      </div>
    </div>
  </div>
</div>