<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reportes del Sistema</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">
  <!-- Navegación / Encabezado -->
  <header class="bg-slate-800 text-white p-4 shadow-md">
    <div class="container mx-auto flex justify-between items-center">
      <h1 class="text-xl font-bold">Reportes y Estadísticas</h1>
      <a href="/" class="text-sm bg-slate-700 hover:bg-slate-600 px-3 py-2 rounded text-white transition">Volver al Inicio</a>
    </div>
  </header>

  <!-- Contenido principal -->
  <main class="container mx-auto flex-1 p-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <!-- Tarjeta 1: Total Ventas -->
      <div class="bg-white p-6 rounded-lg shadow border-l-4 border-blue-500">
        <h2 class="text-gray-500 text-sm font-semibold uppercase">Ventas Totales</h2>
        <p class="text-3xl font-bold text-gray-800 mt-2"><%= typeof totalVentas !== 'undefined' ? totalVentas : '0' %></p>
      </div>

      <!-- Tarjeta 2: Lotes Registrados -->
      <div class="bg-white p-6 rounded-lg shadow border-l-4 border-green-500">
        <h2 class="text-gray-500 text-sm font-semibold uppercase">Lotes Activos</h2>
        <p class="text-3xl font-bold text-gray-800 mt-2"><%= typeof totalLotes !== 'undefined' ? totalLotes : '0' %></p>
      </div>

      <!-- Tarjeta 3: Productos en Inventario -->
      <div class="bg-white p-6 rounded-lg shadow border-l-4 border-purple-500">
        <h2 class="text-gray-500 text-sm font-semibold uppercase">Productos Totales</h2>
        <p class="text-3xl font-bold text-gray-800 mt-2"><%= typeof totalProductos !== 'undefined' ? totalProductos : '0' %></p>
      </div>
    </div>

    <!-- Sección del Resumen -->
    <div class="bg-white p-6 rounded-lg shadow">
      <h2 class="text-lg font-bold text-gray-700 mb-4">Resumen General</h2>
      <p class="text-gray-600">Selecciona un rango de fechas o revisa los indicadores para exportar información consolidada.</p>
    </div>
  </main>
</body>
</html>