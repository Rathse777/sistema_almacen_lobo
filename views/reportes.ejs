<% layout('layout') -%>
<% title = 'Reportes' %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
  <div>
    <h2 class="fw-bold" style="letter-spacing: -0.5px;">
      <i class="fas fa-chart-line me-2 text-primary"></i>Reportes del Sistema
    </h2>
    <p class="text-muted" style="font-size: 0.9rem;">Consulta métricas y resumen general de operaciones</p>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-md-4">
    <div class="card-modern text-center p-3">
      <div class="text-muted small mb-1">Total Ventas</div>
      <h3 class="fw-bold text-success mb-0">$<%= typeof totalVentas !== 'undefined' ? totalVentas : '0.00' %></h3>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card-modern text-center p-3">
      <div class="text-muted small mb-1">Total Lotes Registrados</div>
      <h3 class="fw-bold text-primary mb-0"><%= typeof totalLotes !== 'undefined' ? totalLotes : 0 %></h3>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card-modern text-center p-3">
      <div class="text-muted small mb-1">Productos Registrados</div>
      <h3 class="fw-bold text-info mb-0"><%= typeof totalProductos !== 'undefined' ? totalProductos : 0 %></h3>
    </div>
  </div>
</div>

<div class="row g-4">
  <div class="col-12">
    <div class="card-modern">
      <div class="card-header">
        <i class="fas fa-file-alt me-2"></i> Resumen de Operaciones
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-modern mb-0">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Concepto / Tipo</th>
                <th>Detalle</th>
                <th class="text-end">Monto Total</th>
              </tr>
            </thead>
            <tbody>
              <% if (typeof reportes !== 'undefined' && reportes && reportes.length > 0) { %>
                <% reportes.forEach(r => { %>
                  <tr>
                    <td><%= r.fecha %></td>
                    <td>
                      <span class="badge <%= r.tipo === 'Venta' ? 'bg-success' : 'bg-primary' %> text-white">
                        <%= r.tipo %>
                      </span>
                    </td>
                    <td><%= r.descripcion || 'Sin detalle' %></td>
                    <td class="text-end fw-bold">$<%= r.monto %></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="4" class="text-center text-muted py-4">
                    <i class="fas fa-info-circle me-1"></i> No hay datos de reportes disponibles.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>