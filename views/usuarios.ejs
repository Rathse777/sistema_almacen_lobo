<% layout('layout') -%>
<% title = 'Usuarios' %>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
  <div>
    <h2 class="fw-bold" style="letter-spacing: -0.5px;">
      <i class="fas fa-users me-2 text-primary"></i>Gestión de Usuarios
    </h2>
    <p class="text-muted" style="font-size: 0.9rem;">Administra el acceso al sistema</p>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-5">
    <div class="card-modern">
      <div class="card-header">
        <i class="fas fa-user-plus me-2"></i> Crear Usuario
      </div>
      <div class="card-body">
        <form method="POST" action="/usuarios">
          <div class="mb-3">
            <label class="form-label fw-semibold">Nombre</label>
            <input name="nombre" class="form-control" placeholder="Nombre de usuario" required>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Rol</label>
            <select name="rol" class="form-select" required>
              <option value="admin">Administrador</option>
              <option value="cajero">Cajero</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">Contraseña</label>
            <input name="contraseña" type="password" class="form-control" placeholder="••••••••" required>
          </div>
          <button class="btn btn-modern-primary w-100">
            <i class="fas fa-save me-2"></i> Crear Usuario
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card-modern">
      <div class="card-header">
        <i class="fas fa-list me-2"></i> Listado de Usuarios
        <span class="badge bg-secondary rounded-pill ms-2"><%= usuarios ? usuarios.length : 0 %></span>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-modern mb-0">
            <thead>
              <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Rol</th>
                <th class="text-center">Estado</th>
                <th class="text-center">Acciones</th>
              </tr>
            </thead>
            <tbody>
              <% usuarios.forEach(u => { %>
                <tr>
                  <td><span class="badge bg-secondary bg-opacity-10 text-dark fw-normal">#<%= u.Id_usuario %></span></td>
                  <td><strong><%= u.nombre %></strong></td>
                  <td>
                    <span class="badge <%= u.rol === 'admin' ? 'bg-danger' : 'bg-info' %> text-white">
                      <%= u.rol === 'admin' ? '🔑 Admin' : '👤 Cajero' %>
                    </span>
                  </td>
                  <td class="text-center">
                    <span class="badge badge-stock-ok">
                      <i class="fas fa-check-circle me-1"></i> Activo
                    </span>
                  </td>
                  <td class="text-center">
                    <% if (usuario && usuario.Id_usuario !== u.Id_usuario) { %>
                      <form method="POST" action="/usuarios/<%= u.Id_usuario %>/eliminar" style="display: inline;" onsubmit="return confirm('¿Estás seguro de eliminar este usuario?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar Usuario">
                          <i class="fas fa-trash-alt"></i>
                        </button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div> 